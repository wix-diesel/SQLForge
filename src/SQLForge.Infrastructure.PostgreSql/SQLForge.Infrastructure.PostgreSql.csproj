<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SQLForge.Infrastructure.PostgreSql</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- 共通の足回り（AdoDatabaseSession・台帳・プローブ）を借りる。 -->
    <ProjectReference Include="..\SQLForge.Infrastructure\SQLForge.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- PostgreSQL のドライバーはこのプロジェクトの外へ出ない。 -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <!-- 識別子の引用符付けは外へ出す型ではないので、テストにだけ見せる。 -->
    <InternalsVisibleTo Include="SQLForge.Ui.Tests" />
  </ItemGroup>
</Project>
