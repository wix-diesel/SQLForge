<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SQLForge.Ui</RootNamespace>
    <AssemblyName>SQLForge</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Linux が初期対象。Windows / macOS も同じコードのまま publish できるようにしておく。 -->
    <RuntimeIdentifiers>linux-x64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <!-- Avalonia.Diagnostics（DevTools）は Avalonia 12 系がまだリリースされていないため一時的に除外。
         12 系パッケージが出たら復元する。 -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SQLForge.Infrastructure\SQLForge.Infrastructure.csproj" />
    <!-- 合成ルートだけがドライバーの実装を知る。DBMS を増やすときはここへ 1 行足す。 -->
    <ProjectReference Include="..\SQLForge.Infrastructure.SqlServer\SQLForge.Infrastructure.SqlServer.csproj" />
    <ProjectReference Include="..\SQLForge.Infrastructure.PostgreSql\SQLForge.Infrastructure.PostgreSql.csproj" />
    <!-- OS 依存も同じく合成ルートだけが知る。OS を増やすときはここへ 1 行足す。 -->
    <ProjectReference Include="..\SQLForge.Infrastructure.Linux\SQLForge.Infrastructure.Linux.csproj" />
    <ProjectReference Include="..\SQLForge.Infrastructure.Windows\SQLForge.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\SQLForge.Infrastructure.MacOs\SQLForge.Infrastructure.MacOs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
