<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sec="using:SQLForge.Ui.ViewModels.Security"
        x:Class="SQLForge.Ui.Views.DatabaseUserWindow"
        x:DataType="sec:DatabaseUserDialogViewModel"
        Title="SQLForge — データベース ユーザー"
        Width="520" Height="640"
        MinWidth="460" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextBaseBrush}"
        FontFamily="{DynamicResource FontFamilyUi}"
        FontSize="{DynamicResource FontSizeBase}">

  <!-- SSMS の「データベース ユーザー」ダイアログに対応する。 -->
  <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- 見出し -->
      <Border Grid.Row="0"
              Height="{DynamicResource DialogHeaderHeight}"
              Padding="14,0"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Path Grid.Column="0" Classes="icon accent" Data="{StaticResource IconUser}"/>
          <TextBlock Grid.Column="1"
                     Text="{Binding Title}"
                     FontSize="{DynamicResource FontSizeLg}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextHighBrush}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!--
        入力欄。スクロールするのはメンバーシップの一覧だけにして、上の欄は常に出したままにする。
        画面全体にもスクロールを持たせると入れ子になり、一覧の上でホイールを回しても外側が動かず、
        一番下の選択肢に手が届かなくなる。
      -->
      <Grid Grid.Row="1" Margin="18,16" RowDefinitions="Auto,*" RowSpacing="13">
        <StackPanel Grid.Row="0" Spacing="13">

          <StackPanel Spacing="5">
            <TextBlock Classes="label" Text="ユーザーの種類"/>
            <ComboBox ItemsSource="{Binding TypeChoices}"
                      SelectedItem="{Binding SelectedType}"
                      IsEnabled="{Binding CanChangeType}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="sec:DatabaseUserTypeChoiceViewModel">
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="nodeDetail"
                       Text="種類は作成のときに決まります。あとから変えることはできません。"
                       IsVisible="{Binding !CanChangeType}"/>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Classes="label" Text="ユーザー名"/>
            <TextBox Name="NameBox"
                     Text="{Binding Name}"
                     Classes.error="{Binding HasNameError}"
                     Watermark="ユーザー名"/>
          </StackPanel>

          <StackPanel Spacing="5" IsVisible="{Binding RequiresLogin}">
            <TextBlock Classes="label" Text="ログイン名"/>
            <TextBox Classes="mono"
                     Text="{Binding LoginName}"
                     Classes.error="{Binding HasLoginError}"
                     Watermark="サーバー ログイン名"/>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Classes="label" Text="既定のスキーマ"/>
            <ComboBox ItemsSource="{Binding SchemaChoices}"
                      SelectedItem="{Binding DefaultSchema}"
                      HorizontalAlignment="Stretch"/>
            <TextBlock Classes="nodeDetail" Text="未指定なら dbo が使われます。"/>
          </StackPanel>

        </StackPanel>

        <!-- 一覧は余った高さいっぱいに広げる。ウィンドウを縦に伸ばせばそのぶん多く見える。 -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="5">
          <TextBlock Grid.Row="0" Classes="label" Text="メンバーシップ（データベース ロール）"/>
          <Border Grid.Row="1"
                  MinHeight="110"
                  Background="{DynamicResource InputBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusMd}">
            <!--
              余白は中身（ItemsControl）側に置く。ScrollViewer の Padding にすると
              スクロールできる長さ（Extent）にその分が入らず、最後の 1 行が
              どこまで送っても欄の外に残ってしまう。
            -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Roles}" Margin="10,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="sec:DatabaseRoleChoiceViewModel">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsMember}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>

      </Grid>

      <!-- 直前の操作の結果と確定操作 -->
      <Border Grid.Row="2"
              Height="{DynamicResource DialogFooterHeight}"
              Padding="16,0"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      Spacing="7"
                      VerticalAlignment="Center"
                      IsVisible="{Binding HasError}">
            <Path Classes="icon danger" Data="{StaticResource IconAlertCircle}"/>
            <TextBlock Classes="statusHeadline error"
                       Text="{Binding ErrorMessage}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding ErrorMessage}"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <Button Theme="{StaticResource GhostButton}"
                    Content="キャンセル"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"/>
            <Button Theme="{StaticResource PrimaryButton}"
                    Content="OK"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    IsEnabled="{Binding !IsBusy}"/>
          </StackPanel>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>
