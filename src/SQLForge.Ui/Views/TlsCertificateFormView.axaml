<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SQLForge.Ui.ViewModels"
             x:Class="SQLForge.Ui.Views.TlsCertificateFormView"
             x:DataType="vm:ConnectDialogViewModel">

  <!-- 接続ダイアログ「TLS / SSL」タブ -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18,16,18,16" Spacing="13">

      <!-- 「一般」タブで決まっている要求レベル。ここでは読むだけ -->
      <Border Padding="12,10"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource RadiusLg}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Path Grid.Column="0"
                Classes="icon"
                Classes.success="{Binding Form.Certificate.ValidatesCertificate}"
                Data="{StaticResource IconShield}"
                VerticalAlignment="Top"
                Margin="0,3,0,0"/>
          <StackPanel Grid.Column="1" Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="暗号化"
                         Foreground="{DynamicResource TextHighBrush}"
                         VerticalAlignment="Center"/>
              <TextBlock Classes="mono"
                         Text="{Binding Form.Certificate.EncryptionName}"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Classes="label" Text="{Binding Form.Certificate.TrustSummary}"/>
            <TextBlock Classes="label"
                       TextWrapping="Wrap"
                       Text="要求の強さは「一般」タブの TLS で決まります。同じことを 2 か所で決めないよう、ここでは変えられません。"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 証明書内のホスト名 -->
      <StackPanel Spacing="5">
        <TextBlock Classes="label" Text="証明書内のホスト名"/>
        <TextBox Classes="mono"
                 Text="{Binding Form.Certificate.HostNameInCertificate}"
                 PlaceholderText="証明書の CN / SAN に書かれている名前"/>
        <TextBlock Classes="label"
                   TextWrapping="Wrap"
                   Text="繋ぎに行く名前と証明書に書かれた名前が違うときに、突き合わせる名前をこちらで決めます（SSMS の Host Name in Certificate）。SSH トンネルごしの接続では必ず要ります。"/>
      </StackPanel>

      <!-- サーバー証明書 -->
      <StackPanel Spacing="5">
        <TextBlock Classes="label" Text="サーバー証明書"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Classes="mono"
                   Text="{Binding Form.Certificate.ServerCertificatePath}"
                   PlaceholderText="/etc/ssl/certs/sqlserver.pem"/>
          <Button Grid.Column="1"
                  Theme="{StaticResource SecondaryButton}"
                  Command="{Binding Form.Certificate.BrowseServerCertificateCommand}"
                  IsVisible="{Binding Form.Certificate.CanBrowse}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconFolder}"/>
              <TextBlock Text="参照…" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock Classes="label"
                   TextWrapping="Wrap"
                   Text="指定すると、サーバーが出した証明書をこの 1 枚とだけ突き合わせます。社内の認証局を OS の信頼ストアへ入れずに検証したいときに使います。"/>
      </StackPanel>

      <!-- 検証しない設定のときの断り書き -->
      <Border Padding="12,10"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource RadiusLg}"
              IsVisible="{Binding Form.Certificate.ShowsIgnoredNotice}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Path Classes="icon danger" Data="{StaticResource IconAlertCircle}" VerticalAlignment="Top" Margin="0,2,0,0"/>
          <TextBlock Classes="label"
                     TextWrapping="Wrap"
                     MaxWidth="520"
                     Text="今の TLS の設定では証明書を検証しないので、ここの指定は使われません（保存はされます）。効かせるには「一般」タブの TLS を［必須 + 証明書検証］か［厳密 (TDS 8.0)］にしてください。"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
