<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SQLForge.Ui.ViewModels"
             xmlns:explorer="using:SQLForge.Ui.ViewModels.Explorer"
             x:Class="SQLForge.Ui.Views.ObjectExplorerPane"
             x:DataType="vm:MainWindowViewModel">

  <!-- メインウィンドウ左ペイン: 接続 → データベース / セキュリティ → スキーマ・ログイン → テーブル・ユーザー -->
  <Border Background="{DynamicResource BgPanelBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,0,1,0">
    <Grid RowDefinitions="Auto,*">

      <!-- 見出しと読み直し -->
      <Border Grid.Row="0"
              Height="28"
              Padding="10,0"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Classes="groupHeader"
                     Text="オブジェクトエクスプローラー"/>
          <Button Grid.Column="1"
                  Theme="{StaticResource IconButton}"
                  Command="{Binding Explorer.RefreshCommand}"
                  ToolTip.Tip="読み直す">
            <Path Classes="icon" Data="{StaticResource IconRefresh}"/>
          </Button>
        </Grid>
      </Border>

      <!-- ツリー本体 -->
      <TreeView Grid.Row="1"
                ItemsSource="{Binding Explorer.Roots}"
                SelectedItem="{Binding Explorer.SelectedNode, Mode=TwoWay}"
                ItemContainerTheme="{StaticResource ExplorerTreeItem}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <TreeView.DataTemplates>

          <!-- 接続（根） -->
          <TreeDataTemplate DataType="explorer:ServerNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="接続解除" Command="{Binding DisconnectCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon success"
                    Data="{StaticResource IconDatabase}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName"
                         Text="{Binding Title}"
                         FontWeight="Medium"
                         Foreground="{DynamicResource TextHighBrush}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"/>
            </Grid>
          </TreeDataTemplate>

          <!-- 見出し（データベース / スキーマ / テーブル） -->
          <TreeDataTemplate DataType="explorer:CatalogFolderNode" ItemsSource="{Binding Children}">
            <!-- 背景を敷かないと、行の空いているところで右クリックを拾えない。 -->
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="フィルター" IsVisible="{Binding CanFilter}">
                    <MenuItem Header="フィルターの設定…" Command="{Binding EditFilterCommand}"/>
                    <MenuItem Header="フィルターの削除" Command="{Binding RemoveFilterCommand}"/>
                  </MenuItem>
                  <MenuItem Header="最新の情報に更新" Command="{Binding RefreshCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconFolder}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName" Text="{Binding DisplayTitle}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"/>
            </Grid>
          </TreeDataTemplate>

          <!-- データベース -->
          <TreeDataTemplate DataType="explorer:DatabaseNode" ItemsSource="{Binding Children}">
            <!-- 背景を敷かないと、行の空いているところで右クリックを拾えない。 -->
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="新しいクエリ" Command="{Binding OpenQueryCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon accent" Data="{StaticResource IconCatalog}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName"
                         Classes.system="{Binding IsSystem}"
                         Text="{Binding Title}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"/>
            </Grid>
          </TreeDataTemplate>

          <!-- スキーマの見出し（右クリックから追加できる） -->
          <TreeDataTemplate DataType="explorer:SchemasNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="新しいスキーマ…" Command="{Binding NewSchemaCommand}"/>
                  <MenuItem Header="フィルター" IsVisible="{Binding CanFilter}">
                    <MenuItem Header="フィルターの設定…" Command="{Binding EditFilterCommand}"/>
                    <MenuItem Header="フィルターの削除" Command="{Binding RemoveFilterCommand}"/>
                  </MenuItem>
                  <MenuItem Header="最新の情報に更新" Command="{Binding RefreshCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconFolder}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName" Text="{Binding DisplayTitle}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"/>
            </Grid>
          </TreeDataTemplate>

          <!-- スキーマ（所有者は右端。右クリックから所有者を付け替える） -->
          <TreeDataTemplate DataType="explorer:SchemaNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="プロパティ" Command="{Binding PropertiesCommand}"/>
                  <MenuItem Header="削除" Command="{Binding DeleteCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon"
                    Stroke="{DynamicResource TealBrush}"
                    Data="{StaticResource IconSchema}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName"
                         Classes.system="{Binding IsSystem}"
                         Text="{Binding Title}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"
                         HorizontalAlignment="Right"/>
            </Grid>
          </TreeDataTemplate>

          <!-- テーブル（行数は右端。下に「列」の見出しを持つ） -->
          <TreeDataTemplate DataType="explorer:TableNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="クエリを実行" Command="{Binding OpenQueryCommand}"/>
                  <MenuItem Header="先頭 1000 件を表示" Command="{Binding ShowTopRowsCommand}"/>
                  <MenuItem Header="先頭 100 行を編集" Command="{Binding EditTopRowsCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconTable}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName" Text="{Binding Title}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"
                         HorizontalAlignment="Right"/>
            </Grid>
          </TreeDataTemplate>

          <!-- カラム（葉。主キーは鍵アイコン、型と NULL 許可は右端） -->
          <TreeDataTemplate DataType="explorer:ColumnNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0">
              <Panel Grid.Column="0" VerticalAlignment="Center">
                <Path Classes="icon accent" Data="{StaticResource IconKey}" IsVisible="{Binding IsPrimaryKey}"/>
                <Path Classes="icon" Data="{StaticResource IconColumn}" IsVisible="{Binding !IsPrimaryKey}"/>
              </Panel>
              <TextBlock Grid.Column="1" Classes="nodeName" Text="{Binding Title}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"
                         HorizontalAlignment="Right"/>
            </Grid>
          </TreeDataTemplate>

          <!-- ストアド プロシージャ（パラメーター数は右端。下に「パラメーター」の見出しを持つ） -->
          <TreeDataTemplate DataType="explorer:StoredProcedureNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="実行" Command="{Binding ExecuteCommand}"/>
                  <MenuItem Header="定義を表示" Command="{Binding ViewDefinitionCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconProcedure}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName" Text="{Binding Title}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"
                         HorizontalAlignment="Right"/>
            </Grid>
          </TreeDataTemplate>

          <!-- ストアド プロシージャのパラメーター（葉。入出力の別と型は右端） -->
          <TreeDataTemplate DataType="explorer:StoredProcedureParameterNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0">
              <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconColumn}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName" Text="{Binding Title}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"
                         HorizontalAlignment="Right"/>
            </Grid>
          </TreeDataTemplate>

          <!-- ログインの見出し（右クリックから追加できる） -->
          <TreeDataTemplate DataType="explorer:ServerLoginsNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="新しいログイン…" Command="{Binding NewLoginCommand}"/>
                  <MenuItem Header="フィルター" IsVisible="{Binding CanFilter}">
                    <MenuItem Header="フィルターの設定…" Command="{Binding EditFilterCommand}"/>
                    <MenuItem Header="フィルターの削除" Command="{Binding RemoveFilterCommand}"/>
                  </MenuItem>
                  <MenuItem Header="最新の情報に更新" Command="{Binding RefreshCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon"
                    Stroke="{DynamicResource CautionBrush}"
                    Data="{StaticResource IconShield}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName" Text="{Binding DisplayTitle}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"/>
            </Grid>
          </TreeDataTemplate>

          <!-- サーバー ログイン（葉。認証方式と既定のデータベースは右端） -->
          <TreeDataTemplate DataType="explorer:ServerLoginNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="プロパティ" Command="{Binding PropertiesCommand}"/>
                  <MenuItem Header="削除" Command="{Binding DeleteCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconKey}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName"
                         Classes.system="{Binding IsSystem}"
                         Text="{Binding Title}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"
                         HorizontalAlignment="Right"/>
            </Grid>
          </TreeDataTemplate>

          <!-- サーバー ロールの見出し（右クリックから追加できる） -->
          <TreeDataTemplate DataType="explorer:ServerRolesNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="新しいサーバー ロール…" Command="{Binding NewRoleCommand}"/>
                  <MenuItem Header="フィルター" IsVisible="{Binding CanFilter}">
                    <MenuItem Header="フィルターの設定…" Command="{Binding EditFilterCommand}"/>
                    <MenuItem Header="フィルターの削除" Command="{Binding RemoveFilterCommand}"/>
                  </MenuItem>
                  <MenuItem Header="最新の情報に更新" Command="{Binding RefreshCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon"
                    Stroke="{DynamicResource CautionBrush}"
                    Data="{StaticResource IconShield}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName" Text="{Binding DisplayTitle}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"/>
            </Grid>
          </TreeDataTemplate>

          <!-- サーバー ロール（葉。所有者とメンバー数は右端） -->
          <TreeDataTemplate DataType="explorer:ServerRoleNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="プロパティ" Command="{Binding PropertiesCommand}"/>
                  <MenuItem Header="削除" Command="{Binding DeleteCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconShield}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName"
                         Classes.system="{Binding IsSystem}"
                         Text="{Binding Title}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"
                         HorizontalAlignment="Right"/>
            </Grid>
          </TreeDataTemplate>

          <!-- ユーザーの見出し（右クリックから追加できる） -->
          <TreeDataTemplate DataType="explorer:DatabaseUsersNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="新しいユーザー…" Command="{Binding NewUserCommand}"/>
                  <MenuItem Header="フィルター" IsVisible="{Binding CanFilter}">
                    <MenuItem Header="フィルターの設定…" Command="{Binding EditFilterCommand}"/>
                    <MenuItem Header="フィルターの削除" Command="{Binding RemoveFilterCommand}"/>
                  </MenuItem>
                  <MenuItem Header="最新の情報に更新" Command="{Binding RefreshCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon"
                    Stroke="{DynamicResource CautionBrush}"
                    Data="{StaticResource IconShield}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName" Text="{Binding DisplayTitle}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"/>
            </Grid>
          </TreeDataTemplate>

          <!-- データベース ユーザー（葉。種類とログインは右端） -->
          <TreeDataTemplate DataType="explorer:DatabaseUserNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="プロパティ" Command="{Binding PropertiesCommand}"/>
                  <MenuItem Header="削除" Command="{Binding DeleteCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconUser}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName"
                         Classes.system="{Binding IsSystem}"
                         Text="{Binding Title}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"
                         HorizontalAlignment="Right"/>
            </Grid>
          </TreeDataTemplate>

          <!-- データベース ロールの見出し（右クリックから追加できる） -->
          <TreeDataTemplate DataType="explorer:DatabaseRolesNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="新しいデータベース ロール…" Command="{Binding NewRoleCommand}"/>
                  <MenuItem Header="フィルター" IsVisible="{Binding CanFilter}">
                    <MenuItem Header="フィルターの設定…" Command="{Binding EditFilterCommand}"/>
                    <MenuItem Header="フィルターの削除" Command="{Binding RemoveFilterCommand}"/>
                  </MenuItem>
                  <MenuItem Header="最新の情報に更新" Command="{Binding RefreshCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon"
                    Stroke="{DynamicResource CautionBrush}"
                    Data="{StaticResource IconShield}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName" Text="{Binding DisplayTitle}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"/>
            </Grid>
          </TreeDataTemplate>

          <!-- データベース ロール（葉。所有者とメンバー数は右端） -->
          <TreeDataTemplate DataType="explorer:DatabaseRoleNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,8,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="プロパティ" Command="{Binding PropertiesCommand}"/>
                  <MenuItem Header="削除" Command="{Binding DeleteCommand}"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconShield}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="nodeName"
                         Classes.system="{Binding IsSystem}"
                         Text="{Binding Title}"/>
              <TextBlock Grid.Column="2" Classes="nodeDetail" Text="{Binding Detail}"
                         HorizontalAlignment="Right"/>
            </Grid>
          </TreeDataTemplate>

          <!-- 読み込み中・空・失敗 -->
          <TreeDataTemplate DataType="explorer:MessageNode" ItemsSource="{Binding Children}">
            <TextBlock Classes="nodeDetail"
                       Classes.failure="{Binding IsFailure}"
                       Text="{Binding Title}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Title}"
                       Margin="0,0,8,0"/>
          </TreeDataTemplate>

        </TreeView.DataTemplates>
      </TreeView>

    </Grid>
  </Border>
</UserControl>
