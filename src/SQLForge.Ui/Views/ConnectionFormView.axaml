<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SQLForge.Ui.ViewModels"
             xmlns:dom="using:SQLForge.Domain.Connections"
             xmlns:pres="using:SQLForge.Ui.Presentation"
             x:Class="SQLForge.Ui.Views.ConnectionFormView"
             x:DataType="vm:ConnectDialogViewModel">

  <!-- 接続ダイアログ「一般」タブ -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18,16,18,16" Spacing="13">

      <!-- 接続名 / 環境タグ -->
      <Grid ColumnDefinitions="*,150" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="5">
          <TextBlock Classes="label" Text="接続名"/>
          <TextBox Text="{Binding Form.Name}"
                   Classes.error="{Binding Form.HasNameError}"
                   Watermark="接続名"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="5">
          <TextBlock Classes="label" Text="環境タグ"/>
          <Border Height="{DynamicResource ControlHeightMd}"
                  Padding="9,0"
                  Background="{DynamicResource InputBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusMd}">
            <ListBox Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     VerticalAlignment="Center"
                     ItemsSource="{Binding Form.EnvironmentChoices}"
                     SelectedItem="{Binding Form.Environment}"
                     ItemContainerTheme="{StaticResource SwatchListItem}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:EnvironmentChoiceViewModel">
                  <Border Classes="envColor"
                          Classes.critical="{Binding IsCritical}"
                          Classes.elevated="{Binding IsElevated}"
                          Classes.normal="{Binding IsNormal}"
                          Classes.neutral="{Binding IsNeutral}"
                          Width="14" Height="14" CornerRadius="3"
                          ToolTip.Tip="{Binding DisplayName}"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </StackPanel>
      </Grid>

      <!-- ドライバー / ホスト / ポート -->
      <Grid ColumnDefinitions="200,*,100" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="5">
          <TextBlock Classes="label" Text="ドライバー"/>
          <ComboBox ItemsSource="{Binding Form.DriverChoices}"
                    SelectedItem="{Binding Form.Driver}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="dom:DatabaseDriver">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="14" Height="14" CornerRadius="3"
                          Background="{DynamicResource TealBrush}"
                          VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="5">
          <TextBlock Classes="label" Text="{Binding Form.HostLabel}"/>
          <TextBox Classes="mono"
                   Classes.error="{Binding Form.HasHostError}"
                   Text="{Binding Form.Host}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="5" IsVisible="{Binding Form.SupportsNetworkAddress}">
          <TextBlock Classes="label" Text="ポート"/>
          <TextBox Classes="mono"
                   Classes.error="{Binding Form.HasPortError}"
                   Text="{Binding Form.Port}"/>
        </StackPanel>
      </Grid>

      <!-- データベース / ユーザー -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="5">
          <TextBlock Classes="label" Text="データベース"/>
          <TextBox Classes="mono"
                   Classes.error="{Binding Form.HasDatabaseError}"
                   Text="{Binding Form.Database}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding Form.RequiresUserName}">
          <TextBlock Classes="label" Text="ユーザー"/>
          <TextBox Classes="mono"
                   Classes.error="{Binding Form.HasUserError}"
                   Text="{Binding Form.User}"/>
        </StackPanel>

        <!-- OS 統合認証では名乗る相手を OS が決めるので、打てる欄ではなく使われる名前を出す -->
        <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding Form.UsesIntegratedAuthentication}">
          <TextBlock Classes="label" Text="OS アカウント"/>
          <Border Height="{DynamicResource ControlHeightMd}"
                  Padding="10,0"
                  Background="{DynamicResource BgPanelBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusMd}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Path Classes="icon" Data="{StaticResource IconLock}" VerticalAlignment="Center"/>
              <TextBlock Classes="mono"
                         Text="{Binding Form.IntegratedAccountName}"
                         ToolTip.Tip="{Binding Form.IntegratedAccountName}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- 認証方式 / パスワード -->
      <Grid ColumnDefinitions="200,*" ColumnSpacing="12" IsVisible="{Binding Form.SupportsNetworkAddress}">
        <StackPanel Grid.Column="0" Spacing="5">
          <TextBlock Classes="label" Text="認証方式"/>
          <ComboBox ItemsSource="{Binding Form.AuthenticationChoices}"
                    SelectedItem="{Binding Form.Authentication}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="pres:AuthenticationChoice">
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- Kerberos の用意が要る OS では、繋ぐ前にその旨を出す -->
        <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding Form.ShowsKerberosNotice}">
          <TextBlock Classes="label" Text="認証の下ごしらえ"/>
          <TextBlock Classes="label"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     Text="この OS の統合認証には Kerberos の設定（kinit で取得した資格情報）が要ります。整っていない場合は接続時に理由が出ます。"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding Form.RequiresPassword}">
          <TextBlock Classes="label" Text="パスワード"/>
          <Border Height="{DynamicResource ControlHeightMd}"
                  Padding="10,0,4,0"
                  Background="{DynamicResource InputBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderStrongBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusMd}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
              <TextBox Grid.Column="0" Classes="mono search"
                       Text="{Binding Form.Password}"
                       PasswordChar="•"
                       RevealPassword="{Binding Form.IsPasswordVisible}"
                       VerticalAlignment="Center"/>
              <ToggleButton Grid.Column="1"
                            Theme="{StaticResource IconToggle}"
                            IsChecked="{Binding Form.IsPasswordVisible}"
                            ToolTip.Tip="パスワードを表示">
                <Path Classes="icon" Data="{StaticResource IconEye}"/>
              </ToggleButton>
              <Border Grid.Column="2" Theme="{StaticResource VerticalDivider}"/>
              <ToggleButton Grid.Column="3"
                            Theme="{StaticResource InlineToggle}"
                            IsChecked="{Binding Form.StoreInKeyring}"
                            IsEnabled="{Binding IsKeyringAvailable}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon"
                        Classes.success="{Binding Form.StoreInKeyring}"
                        Data="{StaticResource IconLock}"/>
                  <TextBlock Text="{Binding KeyringLabel}"
                             FontSize="{DynamicResource FontSizeSm}"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>

      <!-- 読み取り専用モード -->
      <Border Padding="12,10"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource RadiusLg}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <ToggleButton Grid.Column="0"
                        Theme="{StaticResource SwitchToggle}"
                        IsChecked="{Binding Form.IsReadOnly}"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0"/>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="読み取り専用モードで接続する"
                       Foreground="{DynamicResource TextHighBrush}"/>
            <TextBlock Classes="label"
                       TextWrapping="Wrap"
                       Text="INSERT / UPDATE / DELETE / DDL をクライアント側でブロックします。本番接続では既定で有効。"/>
            <TextBlock Foreground="{DynamicResource DangerBrush}"
                       FontSize="{DynamicResource FontSizeSm}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Form.IsUnsafeWriteAccess}"
                       Text="本番タグの接続を書き込み可で開こうとしています。"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 接続 URL -->
      <StackPanel Spacing="5">
        <TextBlock Classes="label" Text="接続 URL"/>
        <Border MinHeight="{DynamicResource ControlHeightMd}"
                Padding="10,7"
                Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}">
          <ItemsControl ItemsSource="{Binding Form.UrlParts}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="pres:ConnectionUrlPart">
                <TextBlock Classes="urlPart"
                           Classes.scheme="{Binding IsScheme}"
                           Classes.database="{Binding IsDatabase}"
                           Classes.param="{Binding IsParameterName}"
                           Text="{Binding Text}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
