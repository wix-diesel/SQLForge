<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLForge.Ui.ViewModels"
        x:Class="SQLForge.Ui.Views.ImportConflictWindow"
        x:DataType="vm:ImportConflictDialogViewModel"
        Title="{Binding Title}"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextBaseBrush}"
        FontFamily="{DynamicResource FontFamilyUi}"
        FontSize="{DynamicResource FontSizeBase}">

  <!-- SSMS の取り込みと同じ 5 択。1 件ずつ尋ね、「すべて」で以降を任せられる。 -->
  <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
    <Grid RowDefinitions="Auto,Auto">

      <StackPanel Grid.Row="0" Margin="20,18" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Path Classes="icon danger"
                Data="{StaticResource IconAlertCircle}"
                VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Headline}"
                     FontSize="{DynamicResource FontSizeLg}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextHighBrush}"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Classes="mono"
                   Text="{Binding Summary}"
                   FontSize="{DynamicResource FontSizeMonoSm}"
                   Foreground="{DynamicResource TextDimBrush}"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Detail}"
                   Foreground="{DynamicResource TextDimBrush}"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <Border Grid.Row="1"
              Height="{DynamicResource DialogFooterHeight}"
              Padding="16,0"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Theme="{StaticResource GhostButton}"
                  Content="キャンセル"
                  Command="{Binding CancelCommand}"
                  IsCancel="True"/>
          <Button Theme="{StaticResource GhostButton}"
                  Content="すべて飛ばす"
                  Command="{Binding SkipAllCommand}"/>
          <Button Theme="{StaticResource SecondaryButton}"
                  Content="飛ばす"
                  Command="{Binding SkipCommand}"
                  IsDefault="True"/>
          <Button Theme="{StaticResource GhostButton}"
                  Content="すべて置き換える"
                  Command="{Binding ReplaceAllCommand}"/>
          <Button Theme="{StaticResource PrimaryButton}"
                  Classes="danger"
                  Content="置き換える"
                  Command="{Binding ReplaceCommand}"/>
        </StackPanel>
      </Border>

    </Grid>
  </Border>
</Window>
