<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:explorer="using:SQLForge.Ui.ViewModels.Explorer"
        x:Class="SQLForge.Ui.Views.ObjectFilterWindow"
        x:DataType="explorer:ObjectFilterDialogViewModel"
        Title="SQLForge — フィルターの設定"
        Width="560" Height="420"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextBaseBrush}"
        FontFamily="{DynamicResource FontFamilyUi}"
        FontSize="{DynamicResource FontSizeBase}">

  <!-- SSMS の「フィルターの設定」に対応する。条件にできるプロパティを 1 行ずつ並べ、
       値を空にした行は条件にしない。条件どうしは AND で重なる。 -->
  <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
    <Grid RowDefinitions="Auto,*,Auto,Auto">

      <!-- 見出し。どの見出しの設定かを道のりで示す。 -->
      <Border Grid.Row="0"
              Height="{DynamicResource DialogHeaderHeight}"
              Padding="14,0"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
          <Path Grid.Column="0" Classes="icon accent" Data="{StaticResource IconFilter}"/>
          <TextBlock Grid.Column="1"
                     Text="フィルターの設定"
                     FontSize="{DynamicResource FontSizeLg}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextHighBrush}"
                     VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2"
                     Classes="mono"
                     Text="{Binding FolderPath}"
                     Foreground="{DynamicResource TextFaintBrush}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding FolderPath}"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- 条件の表。見出しの行と中身の行で同じ列幅を使う。 -->
      <Grid Grid.Row="1" Margin="16,14,16,10" RowDefinitions="Auto,*" RowSpacing="4">

        <Grid Grid.Row="0" ColumnDefinitions="110,150,*" ColumnSpacing="10" Margin="0,0,0,2">
          <TextBlock Grid.Column="0" Classes="label" Text="プロパティ"/>
          <TextBlock Grid.Column="1" Classes="label" Text="演算子"/>
          <TextBlock Grid.Column="2" Classes="label" Text="値"/>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource BgRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}"
                Padding="8,6">
          <ListBox ItemsSource="{Binding Rows}"
                   SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                   ItemContainerTheme="{StaticResource FilterRowItem}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="explorer:ObjectFilterRowViewModel">
                <Grid ColumnDefinitions="110,150,*" ColumnSpacing="10" Margin="0,3">
                  <TextBlock Grid.Column="0"
                             Text="{Binding DisplayName}"
                             ToolTip.Tip="{Binding Description}"
                             VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding Operators}"
                            SelectedItem="{Binding Operator, Mode=TwoWay}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="explorer:FilterOperatorChoiceViewModel">
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Grid Grid.Column="2" ColumnDefinitions="*,Auto,*" ColumnSpacing="6">
                    <TextBox Grid.Column="0"
                             Text="{Binding Value, Mode=TwoWay}"
                             PlaceholderText="{Binding ValueHint}"/>
                    <TextBlock Grid.Column="1"
                               Text="〜"
                               VerticalAlignment="Center"
                               IsVisible="{Binding ShowBound}"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding Bound, Mode=TwoWay}"
                             PlaceholderText="{Binding ValueHint}"
                             IsVisible="{Binding ShowBound}"/>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>

      <!-- 選んでいる行の説明（SSMS のダイアログ下の説明欄にあたる） -->
      <Border Grid.Row="2" Margin="16,0,16,12">
        <TextBlock Classes="nodeDetail"
                   Text="{Binding SelectedRow.Description}"
                   TextWrapping="Wrap"/>
      </Border>

      <!-- 直前の操作の結果と確定操作 -->
      <Border Grid.Row="3"
              Height="{DynamicResource DialogFooterHeight}"
              Padding="16,0"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <Button Grid.Column="0"
                  Theme="{StaticResource SecondaryButton}"
                  Content="フィルターのクリア"
                  Command="{Binding ClearCommand}"/>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="7"
                      VerticalAlignment="Center"
                      Margin="10,0,0,0"
                      IsVisible="{Binding HasError}">
            <Path Classes="icon danger" Data="{StaticResource IconAlertCircle}"/>
            <TextBlock Classes="statusHeadline error"
                       Text="{Binding ErrorMessage}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding ErrorMessage}"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
            <Button Theme="{StaticResource GhostButton}"
                    Content="キャンセル"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"/>
            <Button Theme="{StaticResource PrimaryButton}"
                    Content="OK"
                    Command="{Binding AcceptCommand}"
                    IsDefault="True"/>
          </StackPanel>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>
