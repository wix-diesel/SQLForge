<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sec="using:SQLForge.Ui.ViewModels.Security"
        xmlns:views="using:SQLForge.Ui.Views"
        x:Class="SQLForge.Ui.Views.DatabaseRoleWindow"
        x:DataType="sec:DatabaseRoleDialogViewModel"
        Title="SQLForge — データベース ロール"
        Width="560" Height="700"
        MinWidth="480" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextBaseBrush}"
        FontFamily="{DynamicResource FontFamilyUi}"
        FontSize="{DynamicResource FontSizeBase}">

  <!-- SSMS の「データベース ロール」ダイアログに対応する。 -->
  <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- 見出し -->
      <Border Grid.Row="0"
              Height="{DynamicResource DialogHeaderHeight}"
              Padding="14,0"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Path Grid.Column="0" Classes="icon accent" Data="{StaticResource IconShield}"/>
          <TextBlock Grid.Column="1"
                     Text="{Binding Title}"
                     FontSize="{DynamicResource FontSizeLg}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextHighBrush}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- ページの選択（SSMS の左側のページ一覧にあたる） -->
      <Border Grid.Row="1"
              Height="{DynamicResource DialogTabStripHeight}"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <ListBox Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedPage}"
                 ItemContainerTheme="{StaticResource DialogTabItem}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="sec:SecurityDialogPageViewModel">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <ContentControl Grid.Row="2" Content="{Binding SelectedPage.Content}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="sec:DatabaseRoleDialogViewModel">
            <views:DatabaseRoleGeneralPage/>
          </DataTemplate>
          <DataTemplate DataType="sec:SecurablePermissionsViewModel">
            <views:SecurablesPage/>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

      <!-- 直前の操作の結果と確定操作 -->
      <Border Grid.Row="3"
              Height="{DynamicResource DialogFooterHeight}"
              Padding="16,0"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      Spacing="7"
                      VerticalAlignment="Center"
                      IsVisible="{Binding HasError}">
            <Path Classes="icon danger" Data="{StaticResource IconAlertCircle}"/>
            <TextBlock Classes="statusHeadline error"
                       Text="{Binding ErrorMessage}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding ErrorMessage}"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <Button Theme="{StaticResource GhostButton}"
                    Content="キャンセル"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"/>
            <Button Theme="{StaticResource PrimaryButton}"
                    Content="OK"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    IsEnabled="{Binding !IsBusy}"/>
          </StackPanel>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>
