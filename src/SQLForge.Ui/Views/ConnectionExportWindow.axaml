<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLForge.Ui.ViewModels"
        x:Class="SQLForge.Ui.Views.ConnectionExportWindow"
        x:DataType="vm:ConnectionExportDialogViewModel"
        Title="{Binding Title}"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextBaseBrush}"
        FontFamily="{DynamicResource FontFamilyUi}"
        FontSize="{DynamicResource FontSizeBase}">

  <!-- SSMS の「登録済みサーバーのエクスポート」に対応する。書き出す先と資格情報の扱いを決める。 -->
  <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
    <Grid RowDefinitions="Auto,Auto,Auto">

      <!-- 見出し -->
      <Border Grid.Row="0"
              Height="{DynamicResource DialogHeaderHeight}"
              Padding="14,0"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Path Grid.Column="0" Classes="icon accent" Data="{StaticResource IconExport}"/>
          <TextBlock Grid.Column="1"
                     Text="{Binding Title}"
                     FontSize="{DynamicResource FontSizeLg}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextHighBrush}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="18,16" Spacing="13">

        <StackPanel Spacing="5">
          <TextBlock Classes="label" Text="書き出す対象"/>
          <TextBlock Text="{Binding Target}"
                     Foreground="{DynamicResource TextHighBrush}"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel Spacing="5">
          <TextBlock Classes="label" Text="書き出し先"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Name="PathBox" Text="{Binding FilePath}" PlaceholderText="書き出し先のファイル"/>
            <Button Grid.Column="1"
                    Theme="{StaticResource SecondaryButton}"
                    Content="参照…"
                    Click="OnBrowse"/>
          </Grid>
        </StackPanel>

        <StackPanel Spacing="5">
          <CheckBox Content="ユーザー名とパスワードを書き出さない"
                    IsChecked="{Binding ExcludeCredentials}"/>
          <TextBlock Classes="nodeDetail"
                     Text="外すと、預けてあるパスワードがそのまま読める形でファイルに入ります。受け渡しと保管の仕方に気をつけてください。"
                     TextWrapping="Wrap"
                     IsVisible="{Binding WarnsAboutCredentials}"/>
          <TextBlock Classes="nodeDetail"
                     Text="繋ぎ先は書き出しますが、利用者名とパスワードは含めません。取り込んだ先で入れ直すことになります。"
                     TextWrapping="Wrap"
                     IsVisible="{Binding !WarnsAboutCredentials}"/>
        </StackPanel>

      </StackPanel>

      <Border Grid.Row="2"
              Height="{DynamicResource DialogFooterHeight}"
              Padding="16,0"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <Button Theme="{StaticResource GhostButton}"
                  Content="キャンセル"
                  Command="{Binding CancelCommand}"
                  IsCancel="True"/>
          <Button Theme="{StaticResource PrimaryButton}"
                  Content="書き出し"
                  Command="{Binding ExportCommand}"
                  IsDefault="True"/>
        </StackPanel>
      </Border>

    </Grid>
  </Border>
</Window>
