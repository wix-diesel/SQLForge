<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sec="using:SQLForge.Ui.ViewModels.Security"
             x:Class="SQLForge.Ui.Views.DatabaseUserGeneralPage"
             x:DataType="sec:DatabaseUserDialogViewModel">

  <!-- SSMS の「データベース ユーザー」ダイアログの「全般」ページ。 -->
  <Grid Margin="18,16" RowDefinitions="Auto,*" RowSpacing="13">

        <StackPanel Grid.Row="0" Spacing="13">

          <StackPanel Spacing="5">
            <TextBlock Classes="label" Text="ユーザーの種類"/>
            <ComboBox ItemsSource="{Binding TypeChoices}"
                      SelectedItem="{Binding SelectedType}"
                      IsEnabled="{Binding CanChangeType}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="sec:DatabaseUserTypeChoiceViewModel">
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="nodeDetail"
                       Text="種類は作成のときに決まります。あとから変えることはできません。"
                       IsVisible="{Binding !CanChangeType}"/>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Classes="label" Text="ユーザー名"/>
            <TextBox Name="NameBox"
                     Text="{Binding Name}"
                     Classes.error="{Binding HasNameError}"
                     PlaceholderText="ユーザー名"/>
          </StackPanel>

          <StackPanel Spacing="5" IsVisible="{Binding RequiresLogin}">
            <TextBlock Classes="label" Text="ログイン名"/>
            <TextBox Classes="mono"
                     Text="{Binding LoginName}"
                     Classes.error="{Binding HasLoginError}"
                     PlaceholderText="サーバー ログイン名"/>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Classes="label" Text="既定のスキーマ"/>
            <ComboBox ItemsSource="{Binding SchemaChoices}"
                      SelectedItem="{Binding DefaultSchema}"
                      HorizontalAlignment="Stretch"/>
            <TextBlock Classes="nodeDetail" Text="未指定なら dbo が使われます。"/>
          </StackPanel>

        </StackPanel>

        <!-- 一覧は余った高さいっぱいに広げる。ウィンドウを縦に伸ばせばそのぶん多く見える。 -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="5">
          <TextBlock Grid.Row="0" Classes="label" Text="メンバーシップ（データベース ロール）"/>
          <Border Grid.Row="1"
                  MinHeight="110"
                  Background="{DynamicResource InputBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusMd}">
            <!--
              余白は中身（ItemsControl）側に置く。ScrollViewer の Padding にすると
              スクロールできる長さ（Extent）にその分が入らず、最後の 1 行が
              どこまで送っても欄の外に残ってしまう。
            -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Roles}" Margin="10,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="sec:RoleChoiceViewModel">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsMember}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
  </Grid>
</UserControl>
