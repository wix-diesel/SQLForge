<!--
  SQLForge アイコン
  すべて 16×16 のビューボックスで、線幅 1.3〜1.5px の線画。
  モックアップ (design/*.dc.html) の SVG の d 属性をそのまま持ってきている。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- データベース（アプリのマーク） -->
  <StreamGeometry x:Key="IconDatabase">M3.7,2.8 H12.3 A1.2,1.2 0 0 1 13.5,4.0 V5.8 A1.2,1.2 0 0 1 12.3,7.0 H3.7 A1.2,1.2 0 0 1 2.5,5.8 V4.0 A1.2,1.2 0 0 1 3.7,2.8 Z M3.7,9.0 H12.3 A1.2,1.2 0 0 1 13.5,10.2 V12.0 A1.2,1.2 0 0 1 12.3,13.2 H3.7 A1.2,1.2 0 0 1 2.5,12.0 V10.2 A1.2,1.2 0 0 1 3.7,9.0 Z M4.7,4.9 H5.1 M4.7,11.1 H5.1</StreamGeometry>

  <!-- 検索 -->
  <StreamGeometry x:Key="IconSearch">M2.8,7 A4.2,4.2 0 1 0 11.2,7 A4.2,4.2 0 1 0 2.8,7 M10.2,10.2 L14,14</StreamGeometry>

  <!-- 閉じる -->
  <StreamGeometry x:Key="IconClose">M4,4 L12,12 M12,4 L4,12</StreamGeometry>

  <!-- 下向きシェブロン（ドロップダウン） -->
  <StreamGeometry x:Key="IconChevronDown">M4,6.5 L8,10.5 L12,6.5</StreamGeometry>

  <!-- 追加 -->
  <StreamGeometry x:Key="IconPlus">M8,3.5 V12.5 M3.5,8 H12.5</StreamGeometry>

  <!-- 取り込み -->
  <StreamGeometry x:Key="IconImport">M8,10.4 V2.6 M5.2,7.6 L8,10.4 L10.8,7.6 M2.8,12.8 H13.2</StreamGeometry>

  <!-- パスワードの表示切り替え -->
  <StreamGeometry x:Key="IconEye">M1.6,8 C1.6,8 4,3.8 8,3.8 C12,3.8 14.4,8 14.4,8 C14.4,8 12,12.2 8,12.2 C4,12.2 1.6,8 1.6,8 Z M6.3,8 A1.7,1.7 0 1 0 9.7,8 A1.7,1.7 0 1 0 6.3,8</StreamGeometry>
  <StreamGeometry x:Key="IconEyeOff">M1.6,8 C1.6,8 4,3.8 8,3.8 C12,3.8 14.4,8 14.4,8 C14.4,8 12,12.2 8,12.2 C4,12.2 1.6,8 1.6,8 Z M6.3,8 A1.7,1.7 0 1 0 9.7,8 A1.7,1.7 0 1 0 6.3,8 M2.8,13.2 L13.2,2.8</StreamGeometry>

  <!-- キーリング -->
  <StreamGeometry x:Key="IconLock">M4.0,6.8 H12.0 A1.4,1.4 0 0 1 13.4,8.2 V12.0 A1.4,1.4 0 0 1 12.0,13.4 H4.0 A1.4,1.4 0 0 1 2.6,12.0 V8.2 A1.4,1.4 0 0 1 4.0,6.8 Z M5.2,6.8 V4.9 A2.8,2.8 0 0 1 10.8,4.9 V6.8</StreamGeometry>

  <!-- 接続をテスト -->
  <StreamGeometry x:Key="IconProbe">M8,2.2 V5.6 M8,10.4 V13.8 M2.2,8 H5.6 M10.4,8 H13.8 M6,8 A2,2 0 1 0 10,8 A2,2 0 1 0 6,8</StreamGeometry>

  <!-- 成功 / 失敗 -->
  <StreamGeometry x:Key="IconCheckCircle">M2,8 A6,6 0 1 0 14,8 A6,6 0 1 0 2,8 M5.4,8.2 L7.2,10 L10.6,6.2</StreamGeometry>
  <StreamGeometry x:Key="IconAlertCircle">M2,8 A6,6 0 1 0 14,8 A6,6 0 1 0 2,8 M8,4.8 V8.6 M8,10.8 V11.2</StreamGeometry>

  <!-- 読み取り専用（盾） -->
  <StreamGeometry x:Key="IconShield">M8,2.2 L13,4.2 V8 C13,11.2 10.8,13.2 8,14 C5.2,13.2 3,11.2 3,8 V4.2 Z</StreamGeometry>

</ResourceDictionary>
