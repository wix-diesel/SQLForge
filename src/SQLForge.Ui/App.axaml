<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SQLForge.Ui.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SQLForge/Themes/Tokens.axaml"/>
        <ResourceInclude Source="avares://SQLForge/Themes/Icons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>
    <!-- AvaloniaEdit のコントロールテーマ。クエリエディタの見た目は
         Themes/Controls.axaml で上書きするので、先に読み込んでおく。 -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
    <StyleInclude Source="avares://SQLForge/Themes/Controls.axaml"/>
  </Application.Styles>

</Application>
